# Docker Compose에서 사용할 때 이 파일을 .env 로 복사한 뒤 값을 수정하세요.
# cp .env.example .env

# ── PostgreSQL ──────────────────────────────────────────────
POSTGRES_DB=fms
POSTGRES_USER=fms_user
POSTGRES_PASSWORD=fms_password

# ── MinIO (개발용 로컬 S3) ──────────────────────────────────
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# ── S3 공통 ────────────────────────────────────────────────
S3_BUCKET_NAME=fms-bucket
S3_REGION=ap-northeast-2

# 로컬 MinIO 연결 시 (개발 기본값)
S3_ENDPOINT_URL=http://minio:9000
S3_USE_SSL=false

# 프로덕션 AWS S3 연결 시 — EC2 IAM Role 사용이면 키 불필요
# S3_ENDPOINT_URL=
# S3_USE_SSL=true

# ── Frontend (Vite) ─────────────────────────────────────────
# 브라우저가 직접 호출하는 백엔드 URL
# 개발: localhost 직접 접근
VITE_API_BASE_URL=http://localhost:5000
# 프로덕션 (Nginx /api/ 프록시 사용 시)
# VITE_API_BASE_URL=/api

# ── AWS Cognito (Phase 2) ───────────────────────────────────
COGNITO_REGION=ap-northeast-2
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
# 로컬 개발 시 인증 우회 (X-Debug-User-Sub 헤더로 임의 유저 흉내)
AUTH_DEV_BYPASS=false

# 프론트엔드용 (Vite)
VITE_COGNITO_REGION=ap-northeast-2
VITE_COGNITO_USER_POOL_ID=
VITE_COGNITO_CLIENT_ID=
VITE_COGNITO_DOMAIN=
VITE_COGNITO_REDIRECT_URI=http://localhost:5173/auth/callback

# ── 프로덕션 전용 ───────────────────────────────────────────
# DOMAIN=yourdomain.com
# GUNICORN_WORKERS=3
